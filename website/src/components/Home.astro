---
import Layout from "../layouts/Layout.astro";
import { copy, site, type Language } from "../config";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const zh = lang === "zh";
const features = zh ? [
  ["毫秒级响应", "打开即用，输入即达，把等待时间留给更重要的事。"],
  ["应用与文件搜索", "在一个入口中快速找到应用、文件和目录。"],
  ["命令插件", "计算、目录、待办等能力都可通过命令直接调用。"],
  ["全局快捷键", "使用自定义快捷键，从任何位置立即唤起。"],
  ["灵活设置", "双击启动、固定应用、结果高度均可按习惯调整。"],
  ["原生 Windows 体验", "轻量无边框界面，融入桌面而不打扰工作。"],
] : [
  ["Instant response", "Open, type, and reach what you need without waiting."],
  ["Apps and files", "Find apps, files, and folders from one focused entry point."],
  ["Command plugins", "Run calculator, directory, todo, and more with commands."],
  ["Global hotkeys", "Open TypeGo instantly from anywhere with your own shortcut."],
  ["Flexible settings", "Tune launch behavior, pinned apps, and result height."],
  ["Native Windows feel", "A lightweight frameless interface that stays out of your way."],
];
---

<Layout lang={lang} description={zh ? "TypeGo 是轻量、高效的 Windows 启动器，内存使用低至 35 MB。" : "TypeGo is a fast, lightweight Windows launcher using as little as 35 MB of memory."}>
  <h1>{zh ? "轻快启动一切，内存低至 35 MB" : "Launch anything fast, from just 35 MB"}</h1>
  <p>{zh ? "TypeGo 把应用、文件、命令与插件放进一个简洁入口。轻量驻留，随时响应，不打断你的思路。" : "TypeGo brings apps, files, commands, and plugins into one focused launcher. It stays light and responds the moment you need it."}</p>
  <ul>
    <li><a href={site.downloadUrl}>{t.download}</a></li>
    <li><a href={lang === "zh" ? "/download#changelog" : "/en/download#changelog"}>{zh ? "查看更新日志" : "View changelog"}</a></li>
  </ul>
  <p><small>{t.requirements}</small></p>

  <h2>{zh ? "核心能力" : "Core features"}</h2>
  <p>{zh ? "每一项能力都围绕更快找到、更快执行而设计。" : "Every capability is designed to help you find and act faster."}</p>
  <ul>
    {features.map(([title, desc]) => <li><b>{title}</b> — {desc}</li>)}
  </ul>

  <h2>{zh ? "更轻的常驻，更快的抵达。" : "A lighter footprint. A faster way there."}</h2>
  <p><a href={site.downloadUrl}>{t.download}</a></p>
</Layout>
