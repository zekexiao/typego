---
import Layout from "../layouts/Layout.astro";
import { copy, site, type Language } from "../config";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const zh = lang === "zh";
const features = zh ? [
  ["毫秒级响应", "打开即用，输入即达，把等待时间留给更重要的事。"],
  ["应用、文件与命令", "一个入口搜索应用、文件和目录，计算与插件命令同样直达。"],
  ["截图与标注", "按 F1 框选、单击窗口或整屏截图，支持标注、长截图、贴图与历史。"],
  ["剪贴板历史", "输入 clip 搜索复制过的文字、图片和文件，回车即可重新复制。"],
  ["开发者小工具", "内置 JSON / MessagePack 查看器，提供插件 SDK 让你自建工具。"],
  ["全局快捷键与插件", "用自定义快捷键从任何位置唤起，插件承载你常用的工作流。"],
] : [
  ["Instant response", "Open, type, and reach what you need without waiting."],
  ["Apps, files, and commands", "Find apps, files, and folders from one entry, with calculator and plugin commands on the same path."],
  ["Screenshots and markup", "Press F1 for a region, window, or full-screen shot, with annotations, scrolling capture, pinning, and history."],
  ["Clipboard history", "Type clip to search copied text, images, and files, then press Enter to copy again."],
  ["Developer utilities", "A built-in JSON / MessagePack viewer plus a plugin SDK for tools of your own."],
  ["Hotkeys and plugins", "Summon TypeGo from anywhere with your own shortcut, and extend it with plugins."],
];
---

<Layout lang={lang} description={zh ? "TypeGo 是一套装在 27 MB 里的 Windows 快速工具：启动器、截图标注、剪贴板历史与开发者小工具。" : "TypeGo is a Windows toolbox in 27 MB: launcher, screenshot markup, clipboard history, and developer utilities."}>
  <h1>{zh ? "一套工具，27 MB" : "A whole toolbox in 27 MB"}</h1>
  <p>{zh ? "TypeGo 把启动器、截图标注、剪贴板历史和开发者小工具收进同一个进程。常驻约 27 MB：内存留给你的工作，而不是留给后台程序。" : "TypeGo puts the launcher, screenshot markup, clipboard history, and developer utilities into one process. It sits at about 27 MB, so memory goes to your work instead of background apps."}</p>
  <ul>
    <li><a href={site.downloadUrl}>{t.download}</a></li>
    <li><a href={lang === "zh" ? "/download#changelog" : "/en/download#changelog"}>{zh ? "查看更新日志" : "View changelog"}</a></li>
  </ul>
  <p><small>{t.requirements}</small></p>

  <h2>{zh ? "一个快捷键，一整套工具" : "One hotkey, a whole toolbox"}</h2>
  <p>{zh ? "启动器只是入口，真正省下的是切换窗口和等待的时间。" : "The launcher is only the entry point; what it really saves is switching windows and waiting."}</p>
  <ul>
    {features.map(([title, desc]) => <li><b>{title}</b> — {desc}</li>)}
  </ul>

  <h2>{zh ? "更快，也更轻。" : "Faster, and lighter."}</h2>
  <p>{zh ? "同样的工作，用更少的内存和更短的等待完成：这就是 TypeGo 的取舍。" : "Same work, less memory and less waiting: that is the trade TypeGo makes."}</p>
  <p><a href={site.downloadUrl}>{t.download}</a></p>
</Layout>