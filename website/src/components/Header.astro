---
import { Menu, X } from "@lucide/astro";
import { copy, type Language } from "../config";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const path = Astro.url.pathname;
const downloadPath = lang === "zh" ? "/download" : "/en/download";
const languageUrl = lang === "zh"
  ? `/en${path === "/" ? "/" : path}`
  : path.replace(/^\/en(?=\/|$)/, "") || "/";
---

<div class="header-space"></div>
<header class="header-wrap">
  <div class="header">
    <a class="logo" href={t.nav[0][1]} aria-label="TypeGo">
      <img src="/assets/icon.png" alt="" />
      <span>TypeGo</span>
    </a>
    <nav id="nav">
      {t.nav.map(([name, url]) => <a class={url === downloadPath ? "nav-download" : undefined} href={url}>{name}</a>)}
    </nav>
    <div class="header-actions">
      <a class="language" href={languageUrl}>{t.language}</a>
      <button id="menu" class="menu-button" aria-label="Menu"><Menu class="open-icon" size={18} /><X class="close-icon" size={18} /></button>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>("#menu");
  const nav = document.querySelector<HTMLElement>("#nav");
  menu?.addEventListener("click", () => {
    menu.classList.toggle("active");
    nav?.classList.toggle("active");
  });
</script>
