---
import { copy, type Language } from "../config";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const path = Astro.url.pathname;
const languageUrl = lang === "zh"
  ? `/en${path === "/" ? "/" : path}`
  : path.replace(/^\/en(?=\/|$)/, "") || "/";
---

<header>
  <a href={t.nav[0][1]}><b>TypeGo</b></a>
  <nav>
    {t.nav.map(([name, url]) => <a href={url}>{name}</a>)}
    <a href={languageUrl}>{t.language}</a>
  </nav>
</header>
