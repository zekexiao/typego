---
import { copy, type Language } from "../config";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
---

<footer>
  <p>{lang === "zh" ? "专注速度与效率的 Windows 启动器。" : "A Windows launcher focused on speed and efficiency."}</p>
  <nav>{t.nav.map(([name, url]) => <a href={url}>{name}</a>)}</nav>
  <p><small>© {new Date().getFullYear()} TypeGo. {lang === "zh" ? "保留所有权利。" : "All rights reserved."}</small></p>
</footer>
