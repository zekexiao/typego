---
import Layout from "../layouts/Layout.astro";
import { copy, site, type Language } from "../config";
import { releases } from "../data/releases";
const { lang } = Astro.props as { lang: Language }; const zh = lang === "zh"; const t = copy[lang];
// 首条为当前版本，其余为历史版本；文案按语言取对应数组。
const label = zh ? "当前版本" : "Latest";
---
<Layout lang={lang} title={zh ? "下载与更新日志" : "Download & Changelog"} description={zh ? "下载 TypeGo 并查看更新日志。" : "Download TypeGo and view the changelog."}>
  <h1>{zh ? "下载 TypeGo" : "Download TypeGo"} {site.version}</h1>
  <p>{zh ? "适用于 Windows 10 和 Windows 11 的 64 位版本。" : "64-bit release for Windows 10 and Windows 11."}</p>
  <p><a href={site.downloadUrl}>{t.download}</a></p>
  <p><small>{zh ? "下载安装即表示你同意软件许可条款。" : "By installing, you agree to the software license terms."}</small></p>

  <h2 id="changelog">{zh ? "版本历史" : "Version history"}</h2>
  {releases.map((r, i) => (
    <section>
      <h3>TypeGo {r.version}{i === 0 && <>（{label}）</>}{r.tag && <> — {r.tag[lang]}</>} <small><time datetime={r.date}>{r.date}</time></small></h3>
      <ul>
        {r.notes[lang].map(x => <li>{x}</li>)}
      </ul>
    </section>
  ))}
</Layout>
