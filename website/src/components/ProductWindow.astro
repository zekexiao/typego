---
const { lang = "zh" } = Astro.props;
const items = lang === "zh"
  ? [["应用", "快速启动常用程序"], ["计算器", "直接输入算式"], ["目录", "定位并打开文件夹"]]
  : [["Apps", "Launch frequently used apps"], ["Calculator", "Type an expression directly"], ["Directory", "Find and open folders"]];
---

<div class="product-window">
  <div class="window-top"><span></span><span></span><span></span><b>TypeGo</b></div>
  <div class="search"><span class="command">apps</span><i></i></div>
  <div class="result-grid">
    {items.map(([title, desc], i) => (
      <div class:list={["result-item", i === 0 && "selected"]}>
        <div class="app-icon">{title.slice(0, 1)}</div><div><strong>{title}</strong><small>{desc}</small></div>
      </div>
    ))}
  </div>
</div>
