---
import Layout from "../layouts/Layout.astro";
import { type Language } from "../config";
const { lang } = Astro.props as { lang: Language }; const zh = lang === "zh";
const values = zh ? [["性能优先", "每个功能都从启动速度、内存占用和响应延迟出发。"], ["保持专注", "界面只在需要时出现，完成操作后立即回到工作。"], ["能力可扩展", "通过命令和插件把常见工作流收进一个入口。"]] : [["Performance first", "Every feature starts with launch speed, memory use, and response latency."], ["Stay focused", "The interface appears only when needed and gets out of the way after."], ["Extensible by design", "Commands and plugins bring common workflows into one entry point."]];
---
<Layout lang={lang} title={zh ? "关于" : "About"} description={zh ? "了解 TypeGo 的设计理念。" : "Learn about TypeGo's design principles."}>
  <h1>{zh ? "关于 TypeGo" : "About TypeGo"}</h1>
  <p>{zh ? "TypeGo 是一款专注 Windows 的桌面启动器。我们相信高频工具应该足够快、足够轻，也足够安静。" : "TypeGo is a desktop launcher built for Windows. We believe frequently used tools should be fast, lightweight, and quiet."}</p>
  <h2>{zh ? "轻量不是附加项，是设计起点" : "Lightweight is the starting point"}</h2>
  <p>{zh ? "常驻工具会陪伴用户整个工作日，因此每一兆内存、每一次分配和每一段等待都值得认真对待。TypeGo 将性能和内存效率作为首要原则，在能力增长的同时保持克制。" : "A resident tool stays with you all day, so every megabyte, allocation, and pause matters. TypeGo treats performance and memory efficiency as first principles while growing its capabilities with restraint."}</p>
  <ul>
    {values.map(([title, desc]) => <li><b>{title}</b> — {desc}</li>)}
  </ul>
</Layout>
