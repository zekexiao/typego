/*
 * TypeGo 界面设计基线（对齐 Impeccable 规范）
 *
 * 间距：4 / 8 / 12 / 16 / 20 / 24。相关元素靠近，不同分组之间留更大间距，
 *       不要给所有位置同样的 gap。
 * 圆角：6（小控件）/ 8（输入框、按钮、列表项）/ 12（卡片、列表容器）。
 * 字号：13（辅助说明）/ 14（正文与控件）/ 20（页面标题）。界面文字不落到 13px 以下。
 * 颜色：@ACCENT@ 只用于描边、焦点和开关；@ACCENT_FILL@ 用于放白字的实心填充；
 *       @ACCENT_TEXT@ 用于直接落在背景上的强调文字，三者对比度均满足 WCAG AA。
 */

QWidget {
    background-color: transparent;
    color: @TEXT@;
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}

QScrollArea,
QScrollArea > QWidget > QWidget,
QStackedWidget {
    border: none;
    background-color: transparent;
}

QWidget#windowTitleBar {
    background-color: @GLASS_SURFACE@;
    border-bottom: 1px solid @BORDER@;
}

QLabel#windowTitle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 600;
}

/* 关闭按钮的图标由 TitleBarIconButton 自绘，这里只负责热区底色；
   悬停用淡红提示危险操作，不做整块实红，避免和周围的安静控件抢注意力。 */
QPushButton#windowCloseButton {
    min-height: 0;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#windowCloseButton:hover {
    background-color: @CLOSE_TINT@;
}

QPushButton#windowCloseButton:pressed {
    background-color: @CLOSE_TINT_PRESSED@;
}

QFrame#settingsGroup,
QFrame#aboutCard {
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QFrame#profileCard {
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QLabel#profileAvatar {
    background-color: @ACCENT_FILL@;
    color: white;
    border-radius: 24px;
    font-size: 20px;
    font-weight: 700;
}

QLabel#pluginCommand {
    background-color: transparent;
    color: @TEXT@;
    font-weight: 600;
}

QLabel#pageTitle {
    background-color: transparent;
    color: @TEXT@;
    font-size: 20px;
    font-weight: 600;
}

/* 返回与分离按钮同样自绘图标，这里只保留热区。 */
QPushButton#titleBackButton {
    min-height: 0;
    padding: 0;
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
}

QPushButton#titleBackButton:hover {
    background-color: @HOVER@;
    color: @TEXT@;
}

QPushButton#pluginSettingsButton {
    min-width: 68px;
    padding-left: 10px;
    padding-right: 10px;
}

QWidget#settingsView QLabel#section {
    /* 分组标题上方留出比组内间距更大的空隙，让分组边界看得出来。 */
    padding: 14px 2px 2px 2px;
}

QWidget#settingsRow,
QWidget#pluginRow,
QWidget#scanDirectoryEditor,
QScrollArea#settingsScroll,
QWidget#settingsPage {
    background-color: transparent;
    border: none;
}

QLabel#settingLabel {
    color: @TEXT@;
    font-weight: 500;
}

QFrame#settingsDivider {
    background-color: @BORDER@;
    border: none;
}

QFrame#settingsFooter {
    background-color: transparent;
    border: none;
    border-top: 1px solid @BORDER@;
}

QListWidget#scanDirectoryList {
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
}

QListWidget#scanDirectoryList::item {
    min-height: 20px;
    padding: 5px 7px;
    border-radius: 6px;
}

QListWidget#scanDirectoryList::item:selected {
    color: white;
    background-color: @ACCENT_FILL@;
}

QLabel#aboutName {
    color: @TEXT@;
    font-size: 20px;
    font-weight: 600;
}

QLabel#aboutDescription {
    padding-top: 5px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

SettingsSwitch {
    qproperty-accentColor: @ACCENT_FILL@;
}

QWidget#convertView {
    background-color: transparent;
}

QWidget#convertCard {
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QLabel#convertValue {
    background-color: transparent;
    color: @TEXT@;
    font-size: 18px;
    font-weight: 600;
}

/* 导航不画分隔线和左侧色条：选中态用色块与字重表达，避免把普通导航做成告警样式。 */
QListWidget#settingsNavigation {
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
}

QListWidget#settingsNavigation::item {
    min-height: 20px;
    padding: 7px 10px;
    color: @TEXT_SECONDARY@;
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QListWidget#settingsNavigation::item:hover {
    color: @TEXT@;
    background-color: @HOVER@;
}

QListWidget#settingsNavigation::item:selected {
    color: @TEXT@;
    background-color: @SURFACE_PRESSED@;
    font-weight: 600;
}

QLineEdit,
QKeySequenceEdit,
QComboBox {
    min-height: 24px;
    padding: 6px 10px;
    background-color: @GLASS_SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    selection-background-color: @ACCENT_FILL@;
    selection-color: white;
}

QFrame#commandInput {
    min-height: 36px;
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

/* Qt 样式表不支持 :focus-within，聚焦状态由 CommandLineEdit 设置 focused 动态属性。 */
QFrame#commandInput[focused="true"] {
    border: 1px solid @BORDER_FOCUS@;
}

QLabel#commandBadge {
    padding: 3px 7px;
    background-color: @ACCENT_FILL@;
    color: white;
    border-radius: 6px;
}

QLineEdit#commandArgumentEdit,
QLineEdit#commandArgumentEdit:focus {
    min-height: 24px;
    padding: 0;
    background-color: transparent;
    border: none;
}

/* 聚焦只改描边颜色：加粗描边会让内边距重算，控件高度跳 1px，整行跟着动。
   颜色变化在深浅两套主题里都够明显，且与搜索框的聚焦方式一致。 */
QLineEdit:focus,
QKeySequenceEdit:focus,
QComboBox:focus {
    border-color: @BORDER_FOCUS@;
}

QLineEdit[placeholderText] {
    color: @TEXT@;
}

QComboBox {
    padding-right: 28px;
}

QComboBox:hover {
    background-color: @HOVER@;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
    background-color: transparent;
}

QComboBox QAbstractItemView {
    padding: 4px;
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 0;
    outline: none;
    selection-background-color: @ACCENT_FILL@;
    selection-color: white;
}

QListWidget,
QListView,
QTreeView {
    padding: 4px;
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    outline: none;
}

QListWidget::item {
    min-height: 24px;
    padding: 6px 12px;
    border-radius: 8px;
}

QTreeView::item {
    min-height: 24px;
    padding: 6px 12px;
    border-radius: 8px;
}

/* 单元格编辑器由委托定位，不能继承普通表单输入框的最小高度和内边距。 */
QTreeView#jsonTreeView QLineEdit,
QTreeView#jsonTreeView QAbstractSpinBox,
QTreeView#jsonTreeView QComboBox {
    min-height: 0;
    padding: 0 2px;
    border-radius: 2px;
}

QTreeView#jsonTreeView QLineEdit:focus,
QTreeView#jsonTreeView QAbstractSpinBox:focus,
QTreeView#jsonTreeView QComboBox:focus {
    min-height: 0;
    padding: 0 1px;
    border-radius: 2px;
}

QPlainTextEdit#shellOutput {
    padding: 10px;
    background-color: @GLASS_INSET@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 12px;
    selection-background-color: @ACCENT_FILL@;
    selection-color: white;
}

QPushButton#pinnedAppButton {
    padding: 6px 12px;
}

QListWidget::item:hover,
QTreeView::item:hover {
    background-color: @HOVER@;
}

QListWidget::item:selected,
QTreeView::item:selected {
    background-color: @ACCENT_FILL@;
    color: white;
}

/* 搜索结果由 ResultItemDelegate 自绘，样式表只负责容器外观和文字基色。 */
QListView#searchResults {
    color: @TEXT@;
    selection-background-color: transparent;
    selection-color: @TEXT@;
}

QPushButton {
    min-height: 24px;
    padding: 6px 12px;
    background-color: @GLASS_SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

QPushButton:hover {
    background-color: @HOVER@;
}

QPushButton:pressed {
    background-color: @SURFACE_PRESSED@;
}

QPushButton:disabled {
    color: @PLACEHOLDER@;
}

QPushButton#primary {
    background-color: @ACCENT_FILL@;
    color: white;
    border-color: @ACCENT_FILL@;
    font-weight: 600;
}

/* 主按钮悬停必须保持实心强调色，不能掉回通用按钮的灰底。 */
QPushButton#primary:hover {
    background-color: @ACCENT_PRESSED@;
    border-color: @ACCENT_PRESSED@;
}

QPushButton#primary:pressed {
    background-color: @ACCENT_PRESSED@;
    border-color: @ACCENT_PRESSED@;
}

QPushButton#danger {
    color: @ERROR@;
    border-color: @ERROR@;
}

QPushButton#danger:hover {
    background-color: @ERROR_FILL@;
    border-color: @ERROR_FILL@;
    color: white;
}

QLabel#section {
    padding: 4px 2px 0 2px;
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 600;
}

QLabel#muted {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

QCheckBox {
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
}

QCheckBox::indicator:hover {
    border-color: @BORDER_FOCUS@;
}

QWidget#windowTitleBar QWidget#titleBackSlot {
    background-color: transparent;
    border: none;
}

QWidget#windowTitleBar QPushButton#titleBackButton:hover {
    background-color: @HOVER@;
    color: @TEXT@;
}

QWidget#windowTitleBar QPushButton#titleBackButton:pressed {
    background-color: @SURFACE_PRESSED@;
    color: @TEXT@;
}

QCheckBox::indicator:checked {
    background-color: @ACCENT_FILL@;
    border-color: @ACCENT_FILL@;
    image: url(:/assets/check.svg);
}

QMenu {
    padding: 5px;
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 0;
}

QMenu::item {
    min-height: 24px;
    padding: 6px 24px 6px 12px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: @ACCENT_FILL@;
    color: white;
}

QScrollBar:vertical {
    width: 10px;
    margin: 3px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background-color: @BORDER@;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: @TEXT_SECONDARY@;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QToolTip {
    padding: 5px 8px;
    background-color: @SURFACE_PRESSED@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

/* 顶层只绘制一层染色，子页面保持透明，避免多层背景累积遮住磨砂。 */
QWidget[frostedWindow="true"] {
    background-color: @GLASS_TINT@;
}

/* 系统不支持材质时仍保留完整底色，不让文字直接落在桌面上。 */
QWidget[frostedWindow="false"] {
    background-color: @BG@;
}

/* 弹出窗口独立合成，底板与视口均使用实色，不能借用主窗口的半透明底。 */
QDialog {
    background-color: @BG@;
}

QMenu[frostedWindow="false"],
QComboBox QAbstractItemView > QWidget {
    background-color: @SURFACE@;
}

/* QKeySequenceEdit 是普通 QWidget，样式表的 padding 只把它的自绘背景撑大，
   不会缩进内部的 QLineEdit，所以内边距必须写在子输入框上。
   外层用 min-height 补到和普通输入框一样高（24 内容 + 6×2 内边距 + 1×2 描边 = 38）。 */
QKeySequenceEdit {
    min-height: 36px;
    padding: 0;
}

QKeySequenceEdit QLineEdit,
QKeySequenceEdit QLineEdit:focus {
    min-height: 24px;
    padding: 0 10px;
    border: none;
    background-color: transparent;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 6px 12px;
    border-radius: 8px;
}

/* 与列表控件一致：hover 用浅底，选中用主题色。 */
QComboBox QAbstractItemView::item:hover {
    background-color: @HOVER@;
    color: @TEXT@;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @ACCENT_FILL@;
    color: white;
}

QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background-color: @BORDER@;
}

QMenu::item:disabled {
    color: @PLACEHOLDER@;
}

QPushButton:focus {
    border-color: @BORDER_FOCUS@;
}