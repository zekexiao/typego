/* ????????? 12px?????? 8px??? 14px????? 12px??? 20px? */
QWidget {
    background-color: transparent;
    color: @TEXT@;
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}

QScrollArea,
QScrollArea > QWidget > QWidget,
QStackedWidget {
    border: none;
    background-color: transparent;
}

QWidget#windowTitleBar {
    background-color: @GLASS_SURFACE@;
    border-bottom: 1px solid @BORDER@;
}

QLabel#windowTitle {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#windowCloseButton {
    min-height: 0;
    padding: 0;
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 400;
}

QPushButton#windowCloseButton:hover {
    background-color: @CLOSE_HOVER@;
    color: white;
}

QPushButton#windowCloseButton:pressed {
    background-color: @CLOSE_PRESSED@;
    color: white;
}

QFrame#settingsGroup,
QFrame#aboutCard {
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QFrame#profileCard {
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QLabel#profileAvatar {
    background-color: @ACCENT@;
    color: white;
    border-radius: 24px;
    font-size: 20px;
    font-weight: 700;
}

QLabel#pluginCommand {
    background-color: transparent;
    color: @TEXT@;
    font-weight: 600;
}

QLabel#pageTitle {
    background-color: transparent;
    color: @TEXT@;
    font-size: 20px;
    font-weight: 600;
}

QPushButton#titleBackButton {
    min-height: 0;
    padding: 0;
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 600;
}

QPushButton#titleBackButton:hover {
    background-color: @HOVER@;
    color: @TEXT@;
}

QPushButton#pluginSettingsButton {
    min-width: 68px;
    padding-left: 10px;
    padding-right: 10px;
}

QWidget#settingsView QLabel#pageTitle {
    font-size: 22px;
    font-weight: 600;
}

QWidget#settingsView QLabel#section {
    padding: 8px 2px 0 2px;
}

QWidget#settingsRow,
QWidget#pluginRow,
QWidget#scanDirectoryEditor,
QScrollArea#settingsScroll,
QWidget#settingsPage {
    background-color: transparent;
    border: none;
}

QLabel#settingLabel {
    color: @TEXT@;
    font-weight: 500;
}

QFrame#settingsDivider {
    background-color: @BORDER@;
    border: none;
}

QFrame#settingsFooter {
    background-color: transparent;
    border: none;
    border-top: 1px solid @BORDER@;
}

QListWidget#scanDirectoryList {
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
}

QListWidget#scanDirectoryList::item {
    min-height: 20px;
    padding: 5px 7px;
    border-radius: 5px;
}

QListWidget#scanDirectoryList::item:selected {
    color: @TEXT@;
    background-color: @HOVER@;
}

QLabel#aboutName {
    color: @TEXT@;
    font-size: 22px;
    font-weight: 600;
}

QLabel#aboutDescription {
    padding-top: 5px;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
}

SettingsSwitch {
    qproperty-accentColor: @ACCENT@;
}

QWidget#convertView {
    background-color: transparent;
}

QWidget#convertCard {
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QLabel#convertValue {
    background-color: transparent;
    color: @TEXT@;
    font-size: 18px;
    font-weight: 600;
}

QListWidget#settingsNavigation {
    padding: 2px 12px 2px 0;
    background-color: transparent;
    border: none;
    border-right: 1px solid @BORDER@;
    border-radius: 0;
}

QListWidget#settingsNavigation::item {
    min-height: 20px;
    padding: 7px 10px;
    color: @TEXT_SECONDARY@;
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 6px;
}

QListWidget#settingsNavigation::item:hover {
    color: @TEXT@;
    background-color: @HOVER@;
}

QListWidget#settingsNavigation::item:selected {
    color: @ACCENT@;
    background-color: @HOVER@;
    border-left: 2px solid @ACCENT@;
    font-weight: 600;
}

QLineEdit,
QKeySequenceEdit,
QComboBox {
    min-height: 24px;
    padding: 6px 10px;
    background-color: @GLASS_SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    selection-background-color: @ACCENT@;
    selection-color: white;
}

QFrame#commandInput {
    min-height: 36px;
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

/* Qt 样式表不支持 :focus-within，聚焦状态由 CommandLineEdit 设置 focused 动态属性。 */
QFrame#commandInput[focused="true"] {
    border: 1px solid @BORDER_FOCUS@;
}

QLabel#commandBadge {
    padding: 3px 7px;
    background-color: @ACCENT@;
    color: white;
    border-radius: 6px;
}

QLineEdit#commandArgumentEdit,
QLineEdit#commandArgumentEdit:focus {
    min-height: 24px;
    padding: 0;
    background-color: transparent;
    border: none;
}

QLineEdit:focus,
QKeySequenceEdit:focus,
QComboBox:focus {
    border: 2px solid @BORDER_FOCUS@;
    padding: 5px 9px;
}

QLineEdit[placeholderText] {
    color: @TEXT@;
}

QComboBox {
    padding-right: 28px;
}

QComboBox:focus {
    padding-right: 27px;
}

QComboBox:hover {
    background-color: @HOVER@;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
    background-color: transparent;
}

QComboBox QAbstractItemView {
    padding: 4px;
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 0;
    outline: none;
    selection-background-color: @ACCENT@;
    selection-color: white;
}

QListWidget,
QListView,
QTreeView {
    padding: 4px;
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    outline: none;
}

QListWidget::item {
    min-height: 24px;
    padding: 6px 12px;
    border-radius: 8px;
}

QTreeView::item {
    min-height: 24px;
    padding: 6px 12px;
    border-radius: 8px;
}

QPlainTextEdit#shellOutput {
    padding: 10px;
    background-color: @GLASS_INSET@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 12px;
    selection-background-color: @ACCENT@;
    selection-color: white;
}

QPushButton#pinnedAppButton {
    padding: 6px 12px;
}

QListWidget::item:hover,
QTreeView::item:hover {
    background-color: @HOVER@;
}

QListWidget::item:selected,
QTreeView::item:selected {
    background-color: @ACCENT@;
    color: white;
}

/* 搜索结果由 ResultItemDelegate 自绘，样式表只负责容器外观和文字基色。 */
QListView#searchResults {
    color: @TEXT@;
    selection-background-color: transparent;
    selection-color: @TEXT@;
}

QPushButton {
    min-height: 24px;
    padding: 6px 12px;
    background-color: @GLASS_SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
}

QPushButton:hover {
    background-color: @HOVER@;
}

QPushButton:pressed {
    background-color: @SURFACE_PRESSED@;
}

QPushButton:disabled {
    color: @PLACEHOLDER@;
}

QPushButton#primary {
    background-color: @ACCENT@;
    color: white;
    border-color: @ACCENT@;
    font-weight: 600;
}

QPushButton#primary:pressed {
    background-color: @ACCENT_PRESSED@;
    border-color: @ACCENT_PRESSED@;
}

QPushButton#danger {
    color: @ERROR@;
    border-color: @ERROR@;
}

QPushButton#danger:hover {
    background-color: @ERROR@;
    color: white;
}

QLabel#section {
    padding-top: 8px;
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#muted {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QCheckBox {
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: @GLASS_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border-color: @BORDER_FOCUS@;
}

QWidget#windowTitleBar QWidget#titleBackSlot {
    background-color: transparent;
    border: none;
}

QWidget#windowTitleBar QPushButton#titleBackButton:hover {
    background-color: @HOVER@;
    color: @TEXT@;
}

QWidget#windowTitleBar QPushButton#titleBackButton:pressed {
    background-color: @SURFACE_PRESSED@;
    color: @TEXT@;
}

QCheckBox::indicator:checked {
    background-color: @ACCENT@;
    border-color: @ACCENT@;
    image: url(:/assets/check.svg);
}

QMenu {
    padding: 5px;
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 0;
}

QMenu::item {
    min-height: 24px;
    padding: 6px 24px 6px 12px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: @ACCENT@;
    color: white;
}

QScrollBar:vertical {
    width: 10px;
    margin: 3px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background-color: @BORDER@;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: @TEXT_SECONDARY@;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QToolTip {
    padding: 5px 8px;
    background-color: @SURFACE_PRESSED@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
}

/* 顶层只绘制一层染色，子页面保持透明，避免多层背景累积遮住磨砂。 */
QWidget[frostedWindow="true"] {
    background-color: @GLASS_TINT@;
}

/* 系统不支持材质时仍保留完整底色，不让文字直接落在桌面上。 */
QWidget[frostedWindow="false"] {
    background-color: @BG@;
}

/* 弹出窗口独立合成，底板与视口均使用实色，不能借用主窗口的半透明底。 */
QDialog {
    background-color: @BG@;
}

QMenu[frostedWindow="false"],
QComboBox QAbstractItemView > QWidget {
    background-color: @SURFACE@;
}

/* ???????????????????????? */
QKeySequenceEdit QLineEdit,
QKeySequenceEdit QLineEdit:focus {
    padding: 0;
    border: none;
    background-color: transparent;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 6px 12px;
    border-radius: 8px;
}

/* 与列表控件一致：hover 用浅底，选中用主题色。 */
QComboBox QAbstractItemView::item:hover {
    background-color: @HOVER@;
    color: @TEXT@;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @ACCENT@;
    color: white;
}

QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background-color: @BORDER@;
}

QMenu::item:disabled {
    color: @PLACEHOLDER@;
}

QPushButton:focus {
    border-color: @BORDER_FOCUS@;
}
